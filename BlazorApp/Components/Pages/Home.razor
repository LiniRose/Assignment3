@page "/"

<PageTitle>Home</PageTitle>

<h1>Reddit Clone</h1>

<AuthorizeView>
    <Authorized>
        <h3>Hello, @context.User.Identity?.Name</h3>
    </Authorized>
    <NotAuthorized>
        <p>You are not logged in. <a href="/login">Log in</a> to create posts and comments.</p>
    </NotAuthorized>
</AuthorizeView>

<p>Here you can browse interesting posts.</p>
