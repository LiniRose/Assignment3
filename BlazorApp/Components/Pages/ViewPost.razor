@page "/posts/{Id:int}"
@inject IPostService PostService
@inject ICommentService CommentService

<PageTitle>Post</PageTitle>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (post is null)
{
    @if (string.IsNullOrEmpty(error))
    {
        <p>Loading...</p>
    }
}
else
{
    <h3>@post.Title</h3>
    <p class="text-muted">by @post.UserName</p>
    <p>@post.Body</p>

    <hr />

    <h4>Comments</h4>
    @if (post.Comments is null || post.Comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (CommentDto comment in post.Comments)
            {
                <li class="list-group-item">
                    <strong>@comment.UserName:</strong> @comment.Body
                </li>
            }
        </ul>
    }

    <AuthorizeView>
        <Authorized>
            <div class="mb-3">
                <label class="form-label">Add a comment</label>
                <textarea class="form-control" rows="3" @bind="commentBody"></textarea>
            </div>
            <button class="btn btn-primary" @onclick="AddCommentAsync">Add comment</button>
        </Authorized>
        <NotAuthorized>
            <p><a href="/login">Log in</a> to add a comment.</p>
        </NotAuthorized>
    </AuthorizeView>

    <p class="mt-3"><a href="/posts">Back to posts</a></p>
}

@code {
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = default!;

    [Parameter] public int Id { get; set; }

    private PostDto? post;
    private string commentBody = "";
    private string error = "";

    protected override async Task OnParametersSetAsync()
    {
        await LoadPostAsync();
    }

    private async Task LoadPostAsync()
    {
        try
        {
            post = await PostService.GetPostAsync(Id, includeComments: true);
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task AddCommentAsync()
    {
        error = "";

        try
        {
            AuthenticationState authState = await State;
            int userId = authState.User.GetUserId();

            await CommentService.AddCommentAsync(new CreateCommentDto
            {
                Body = commentBody,
                UserId = userId,
                PostId = Id
            });
            commentBody = "";
            await LoadPostAsync();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }
}
